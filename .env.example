# Public contact email shown in the reserve section and footer.
VITE_BUSINESS_EMAIL=

# Public phone number shown in the reserve section and footer.
VITE_BUSINESS_PHONE=

# WhatsApp number used to build booking links and contact buttons.
VITE_WHATSAPP_NUMBER=

# WhatsApp message appended to the booking link.
VITE_WHATSAPP_MESSAGE=

# Public Airbnb room URL used for the booking CTA.
VITE_AIRBNB_URL=

# Airbnb iCal feed URL for availability synchronization.
VITE_AIRBNB_ICAL_URL=

# Google Maps URL used to generate the embed in the location section.
VITE_GOOGLE_MAPS_URL=

# Google Analytics measurement ID used for analytics tracking.
VITE_GA_MEASUREMENT_ID=
